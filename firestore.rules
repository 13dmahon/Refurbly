rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can read/write their own user document
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && (!request.resource.data.keys().hasAny(['email', 'createdAt']) 
            || request.resource.data.email == resource.data.email);
      // Allow new fields: isPremium, premiumSince, paymentProvider, purchaseType, transactionId, transactionDate, restoredAt
    }
    
    // Users can read/write their own quotes
    match /quotes/{quoteId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Pricing templates: everyone can read, only admin can write
    match /pricingTemplates/{templateId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "dominick.m.mahon@gmail.com";
    }
    
    // Diagnostics: allow authenticated writes
    match /diagnostics/{docId} {
      allow create: if request.auth != null;
    }
  }
}